@model Pessoa
@{
    var editando = Model.Id > 0;
    ViewData["Title"] = editando ? "Editar pessoa" : "Nova pessoa";
}

<div class="page-head">
    <div>
        <p class="eyebrow">Pessoas</p>
        <h1>@ViewData["Title"]</h1>
    </div>
</div>

<div class="cartao-form">
    <form asp-action="@(editando ? "Edit" : "Create")" method="post">
        <input type="hidden" asp-for="Id" />
        <div asp-validation-summary="ModelOnly"></div>
        <div class="row g-3">
            <div class="col-md-6">
                <label asp-for="Nome" class="form-label">Nome</label>
                <input asp-for="Nome" class="form-control" />
                <span asp-validation-for="Nome"></span>
            </div>
            <div class="col-md-6">
                <label asp-for="Cpf" class="form-label">CPF</label>
                <input asp-for="Cpf" class="form-control" placeholder="000.000.000-00" />
                <span asp-validation-for="Cpf"></span>
            </div>
            <div class="col-md-6">
                <label asp-for="Email" class="form-label">E-mail</label>
                <input asp-for="Email" class="form-control" />
                <span asp-validation-for="Email"></span>
            </div>
            <div class="col-md-6">
                <label asp-for="Telefone" class="form-label">Telefone</label>
                <input asp-for="Telefone" class="form-control" placeholder="Opcional" />
                <span asp-validation-for="Telefone"></span>
            </div>
        </div>
        <div class="d-flex gap-2 mt-4">
            <button type="submit" class="btn btn-primary">Salvar</button>
            <a class="btn btn-outline-secondary" asp-action="Index">Cancelar</a>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
