@model List<Pessoa>
@{
    ViewData["Title"] = "Pessoas";
}

<div class="page-head">
    <div>
        <p class="eyebrow">Cadastro</p>
        <h1>Pessoas</h1>
    </div>
    <a class="btn btn-primary" asp-action="Create">Nova pessoa</a>
</div>

@if (TempData["Erro"] is string erro)
{
    <div class="alerta">@erro</div>
}

<div class="painel">
    @if (!Model.Any())
    {
        <p class="vazio">Nenhuma pessoa cadastrada.</p>
    }
    else
    {
        <table class="tabela">
            <thead>
                <tr>
                    <th>Nome</th>
                    <th>CPF</th>
                    <th>E-mail</th>
                    <th>Telefone</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var pessoa in Model)
                {
                    <tr>
                        <td>@pessoa.Nome</td>
                        <td>@pessoa.Cpf</td>
                        <td>@pessoa.Email</td>
                        <td>@(string.IsNullOrWhiteSpace(pessoa.Telefone) ? "—" : pessoa.Telefone)</td>
                        <td>
                            <div class="acoes">
                                <a class="btn-cobre" asp-action="Edit" asp-route-id="@pessoa.Id">Editar</a>
                                <form asp-action="Delete" asp-route-id="@pessoa.Id" method="post" onsubmit="return confirm('Excluir esta pessoa?');">
                                    <button type="submit" class="btn-perigo">Excluir</button>
                                </form>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
</div>
