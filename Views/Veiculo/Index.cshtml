@model List<Veiculo>
@{
    ViewData["Title"] = "Veículos";
}

<div class="page-head">
    <div>
        <p class="eyebrow">Cadastro</p>
        <h1>Veículos</h1>
    </div>
    <a class="btn btn-primary" asp-action="Create">Novo veículo</a>
</div>

@if (TempData["Erro"] is string erro)
{
    <div class="alerta">@erro</div>
}

<div class="painel">
    @if (!Model.Any())
    {
        <p class="vazio">Nenhum veículo cadastrado.</p>
    }
    else
    {
        <table class="tabela">
            <thead>
                <tr>
                    <th>Placa</th>
                    <th>Marca</th>
                    <th>Modelo</th>
                    <th>Ano</th>
                    <th>Cor</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var veiculo in Model)
                {
                    <tr>
                        <td>@veiculo.Placa</td>
                        <td>@veiculo.Marca</td>
                        <td>@veiculo.Modelo</td>
                        <td>@veiculo.Ano</td>
                        <td>@(string.IsNullOrWhiteSpace(veiculo.Cor) ? "—" : veiculo.Cor)</td>
                        <td>
                            <div class="acoes">
                                <a class="btn-cobre" asp-action="Edit" asp-route-id="@veiculo.Id">Editar</a>
                                <form asp-action="Delete" asp-route-id="@veiculo.Id" method="post" onsubmit="return confirm('Excluir este veículo?');">
                                    <button type="submit" class="btn-perigo">Excluir</button>
                                </form>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
</div>
